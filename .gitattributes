# Force LF line endings, needed for Docker to work on Windows
*.sh text eol=lf

# Simulation evidence hashes must survive checkouts on Windows and Linux.
assets/js/udes-v2-*.js text eol=lf
assets/data/udes-v2/*.json text eol=lf
assets/data/udes-v2/*.geojson text eol=lf
scripts/*udes-v2*.mjs text eol=lf
scripts/lib/udes-v2*.mjs text eol=lf
scripts/data/udes-v2-sources/*.json text eol=lf
scripts/data/udes-v2-sources/*.gz binary
scripts/data/udes-v2-transit-services.json text eol=lf

# Preserve experimental archive files exactly, including their original spacing.
molecular-vr/public/data/*.cif binary
molecular-vr/public/data/*.bcif binary
molecular-vr/public/data/*.bin binary
molecular-vr/public/data/motion/*.cif.gz binary
assets/apps/protein-structures/data/*.cif binary
assets/apps/protein-structures/data/*.bcif binary
assets/apps/protein-structures/data/*.bin binary
assets/apps/protein-structures/data/motion/*.cif.gz binary
# Bundled Three.js shaders retain upstream spacing inside template literals.
assets/apps/protein-structures/assets/* -whitespace

# Three.js shader template strings retain their upstream trailing whitespace.
assets/apps/power-systems-lab/assets/* -whitespace

# Committed application bundles are copied verbatim by Jekyll. Never translate
# their module, shader, worker, archive or data bytes during Git checkout.
assets/apps/** -text -whitespace
molecular-vr/public/data/** -text
power-systems-lab/public/data/** -text
circuits-lab/docs/module-designs.md text eol=lf
molecular-vr/index.html text eol=lf
circuits-lab/index.html text eol=lf
bloch-lab/index.html text eol=lf
power-systems-lab/index.html text eol=lf

---
layout: default
---
{% assign word_count = content | number_of_words %}
{% assign read_minutes = word_count | divided_by: 180 | plus: 1 %}
<article class="folio-reader">
  <a class="folio-back-link" href="{{ '/blog/' | relative_url }}" data-page-turn>&larr; Back to the folio</a>
  <header class="folio-reader__header">
    <p>
      {{ page.date | date: '%b %Y' }} &middot; {{ read_minutes }} min{% if page.tags %} &middot; {{ page.tags | first }}{% endif %}
    </p>
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p class="folio-reader__deck">{{ page.description }}</p>
    {% endif %}
  </header>
  {% if page.toc == true or page.toc.beginning %}
    <nav class="folio-reader__toc" aria-label="Table of contents">
      <p>On this page</p>
      {% toc %}
    </nav>
  {% endif %}
  <div id="markdown-content" class="folio-prose folio-essay-body">{{ content }}</div>
  {% if page.tags or page.categories %}
    <footer class="folio-reader__filing">
      {% for tag in page.tags -%}
        <span>#{{ tag }}</span>
      {%- endfor %}
      {% for category in page.categories -%}
        <span>{{ category }}</span>
      {%- endfor %}
    </footer>
  {% endif %}
  <p class="folio-ornament" aria-hidden="true">❦</p>
</article>

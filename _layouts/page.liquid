---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  {% if page.collection == 'projects' %}
    <section class="project-brief" aria-label="Project brief">
      {% if page.image %}
        <img class="project-brief-image" src="{{ page.image | relative_url }}" alt="" loading="lazy">
      {% endif %}
      <div class="project-brief-copy">
        <dl>
          {% if page.role %}
            <div>
              <dt>Role</dt>
              <dd>{{ page.role }}</dd>
            </div>
          {% endif %}
          {% if page.methods %}
            <div>
              <dt>Methods</dt>
              <dd>{{ page.methods }}</dd>
            </div>
          {% endif %}
          {% if page.status %}
            <div>
              <dt>Status</dt>
              <dd>{{ page.status }}</dd>
            </div>
          {% endif %}
        </dl>
        {% if page.signals %}
          <h2>Useful signals</h2>
          <ul>
            {% for signal in page.signals %}
              <li>{{ signal }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if page.artifacts %}
          <h2>Artifacts</h2>
          <div class="project-artifacts">
            {% for artifact in page.artifacts %}
              <a href="{% if artifact.url contains '://' %}{{ artifact.url }}{% else %}{{ artifact.url | relative_url }}{% endif %}">
                {{ artifact.label }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

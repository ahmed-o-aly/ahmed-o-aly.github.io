---
layout: garden
---
<main
  id="main-content"
  class="garden-main udes-v2-main"
  data-udes-v2-root
  data-udes-v2-state="ready"
  data-model-url="{{ page.model_url | relative_url }}"
  data-worker-url="{{ page.worker_url | relative_url }}"
>
  <header class="udes-v2-commandbar" aria-label="Simulation command bar">
    <div class="udes-v2-commandbar__identity">
      <a class="udes-v2-back" href="{{ '/projects/' | relative_url }}" aria-label="Back to projects">
        <span aria-hidden="true">&#8592;</span>
      </a>
      <div class="udes-v2-commandbar__title">
        <span>Illustrative scenario · not a forecast</span>
        <h1>{{ page.title }}</h1>
      </div>
    </div>

    <div class="udes-v2-commandbar__run">
      <div class="udes-v2-clock" aria-label="Model time">
        <span class="udes-v2-status-dot" aria-hidden="true"></span>
        <span>
          <small>Model time</small>
          <strong data-udes-v2-date>Mon, 1 Jan 2024</strong>
        </span>
      </div>

      <div class="udes-v2-playback" role="group" aria-label="Playback controls">
        <button class="udes-v2-button udes-v2-button--primary" type="button" data-udes-v2-action="play" aria-pressed="false">
          <span class="udes-v2-play-icon" aria-hidden="true"></span>
          <span data-udes-v2-play-label>Run</span>
        </button>
        <button class="udes-v2-step-button" type="button" data-udes-v2-step-days="1" aria-label="Advance one day">+1d</button>
        <button class="udes-v2-step-button" type="button" data-udes-v2-step-days="7" aria-label="Advance seven days">+7d</button>
        <button class="udes-v2-step-button" type="button" data-udes-v2-step-days="30" aria-label="Advance thirty days">+30d</button>
        <button class="udes-v2-icon-button" type="button" data-udes-v2-action="reset" aria-label="Reset simulation">
          <span aria-hidden="true">&#8634;</span>
        </button>
      </div>

      <div class="udes-v2-progress" aria-label="Simulation progress">
        <progress data-udes-v2-progress value="0" max="366" aria-label="Simulation progress">Day 0 of 366</progress>
        <span>Day <strong data-udes-v2-progress-label>0</strong> / <span data-udes-v2-horizon-label>366</span></span>
      </div>
    </div>

    <div class="udes-v2-commandbar__context">
      <button class="udes-v2-compare" type="button" data-udes-v2-compare aria-pressed="true">Compare</button>
      <fieldset class="udes-v2-speed">
        <legend>Automatic run step</legend>
        <button type="button" data-udes-v2-speed="1" aria-pressed="true" title="Run one model day per update">1d</button>
        <button type="button" data-udes-v2-speed="7" aria-pressed="false" title="Run seven model days per update">7d</button>
        <button type="button" data-udes-v2-speed="30" aria-pressed="false" title="Run thirty model days per update">30d</button>
      </fieldset>
      <span class="udes-v2-runtime-state" data-udes-v2-runtime-state>
        <span aria-hidden="true"></span>
        Ready
      </span>
    </div>
  </header>

  {{ content }}

  <p class="udes-v2-sr-only" role="status" aria-live="polite" data-udes-v2-live-status>Simulation interface ready.</p>
</main>

---
layout: default
---
{% assign experience = site.data.cv | where: 'title', 'Experience' | first %}
{% assign education = site.data.cv | where: 'title', 'Education' | first %}
{% assign certifications = site.data.cv | where: 'title', 'Certifications' | first %}
{% assign skills = site.data.cv | where: 'title', 'Skills' | first %}

<article class="folio-page folio-records-page">
  <a class="folio-back-link" href="{{ '/' | relative_url }}">&larr; Back to the folio</a>
  <header class="folio-page__header">
    <p class="folio-kicker">Records</p>
    <h1>A working record, kept in order.</h1>
    <p>{{ page.description }}</p>
  </header>

  <div class="folio-records-layout">
    <div>
      <section class="folio-record-section" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <div class="folio-timeline">
          {% for role in experience.contents %}
            <article>
              <time>{{ role.year }}</time>
              <div>
                <h3>{{ role.title }}</h3>
                <p>
                  {{ role.institution -}}
                  {%- if role.location %} &middot; {{ role.location }}{% endif %}
                </p>
                {% if role.description %}
                  <p class="folio-timeline__detail">{{ role.description | first }}</p>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>

      <section class="folio-record-section" aria-labelledby="education-title">
        <h2 id="education-title">Education</h2>
        <div class="folio-timeline">
          {% for item in education.contents %}
            <article>
              <time>{{ item.year }}</time>
              <div>
                <h3>{{ item.title }}</h3>
                <p>{{ item.institution }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>

      <a class="folio-button" href="{{ page.cv_pdf | relative_url }}">Download the full CV &darr;</a>
    </div>

    <aside class="folio-records-aside" aria-labelledby="credentials-title">
      <h2 id="credentials-title">Credentials</h2>
      <div class="folio-credentials-ledger">
        {% for certificate in certifications.contents %}
          <article>
            <time>{{ certificate.year }}</time>
            <div>
              <h3>{{ certificate.title }}</h3>
              <p>{{ certificate.institution }}</p>
              {% if certificate.linkitems %}
                <p class="folio-credential-links">
                  {% for item in certificate.linkitems -%}
                    <a href="{{ item.link | relative_url }}">{{ item.linkname }}</a>
                    {%- unless forloop.last %} &middot; {% endunless -%}
                  {%- endfor %}
                </p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
        {% for item in education.contents %}
          <article>
            <time>{{ item.year }}</time>
            <div>
              <h3>{{ item.title }}</h3>
              <p>{{ item.institution }}</p>
            </div>
          </article>
        {% endfor %}
      </div>

      <section class="folio-skills" aria-labelledby="skills-title">
        <h2 id="skills-title">Working methods</h2>
        <ul>
          {% for item in skills.contents %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </section>
    </aside>
  </div>

  <img class="folio-ornament" src="{{ '/assets/img/folio/bunny-sepia-ornament.svg' | relative_url }}" alt="" width="17" height="27">
</article>

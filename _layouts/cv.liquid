---
layout: default
---
{% assign cv_pdf = site.data.socials.cv_pdf | default: page.cv_pdf %}
{% assign cv_email = site.data.socials.email %}
{% assign cv_linkedin = site.data.socials.linkedin_username %}
{% assign cv_github = site.data.socials.github_username %}
{% assign cv_general_information = site.data.cv | where: 'title', 'General Information' | first %}
{% assign cv_full_name = cv_general_information.contents | where: 'name', 'Full Name' | first %}
{% assign cv_title = cv_full_name.value | default: page.title %}
<article class="garden-cv">
  {% include garden-intro.liquid eyebrow='Curriculum vitae' title=cv_title description=page.description %}
  <nav class="garden-cv__actions" aria-label="CV contact and download actions">
    {% if cv_pdf -%}
      <a class="garden-button" href="{{ cv_pdf | relative_url }}">Download PDF</a>
    {%- endif %}
    {% if cv_email -%}
      <a href="mailto:{{ cv_email }}">Email</a>
    {%- endif %}
    {% if cv_linkedin -%}
      <a href="https://www.linkedin.com/in/{{ cv_linkedin }}/">LinkedIn</a>
    {%- endif %}
    {% if cv_github -%}
      <a href="https://github.com/{{ cv_github }}/">GitHub</a>
    {%- endif %}
  </nav>
  {% for entry in site.data.cv %}
    <section class="garden-cv__section" id="{{ entry.title | slugify }}">
      <h2>{{ entry.title }}</h2>
      {% case entry.type %}
        {% when 'time_table' -%}
          {%- include cv/time_table.liquid heading_tag='h3' %}
        {% when 'list' -%}
          {%- include cv/list.liquid %}
        {% when 'map' -%}
          {%- include cv/map.liquid %}
        {% when 'nested_list' -%}
          {%- include cv/nested_list.liquid heading_tag='h3' %}
        {% when 'list_groups' -%}
          {%- include cv/list_groups.liquid %}
      {% endcase %}
    </section>
  {% endfor %}
</article>

---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign review_cover = page.cover %}
{% if review_cover == blank and page.olid != blank %}
  {% assign review_cover = 'https://covers.openlibrary.org/b/olid/' | append: page.olid | append: '-L.jpg' %}
  {% assign review_cover_source_url = 'https://openlibrary.org/olid/' | append: page.olid %}
{% elsif review_cover == blank and page.isbn != blank %}
  {% assign review_cover = 'https://covers.openlibrary.org/b/isbn/' | append: page.isbn | append: '-L.jpg' %}
  {% assign review_cover_source_url = 'https://openlibrary.org/isbn/' | append: page.isbn %}
{% endif %}
{% capture generated_cover_alt %}{{ page.title }} book cover{% endcapture %}
{% assign review_cover_alt = page.cover_alt | default: generated_cover_alt | strip %}
{% assign started_at = page.started | default: page.start %}
{% assign finished_at = page.finished | default: page.end %}
{% assign archive_year = started_at | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

<article class="garden-book-review">
  <header class="garden-book-review__header">
    <figure class="garden-book-review__cover">
      {%
        include garden-media.liquid
        src=review_cover
        alt=review_cover_alt
        title=page.title
        fit='contain'
        loading='eager'
        fetchpriority='high'
      %}
      {% if review_cover %}
        <figcaption>
          Cover of <cite>{{ page.title }}</cite>
          {%- if review_cover_source_url %}
            via <a href="{{ review_cover_source_url }}">Open Library</a>
          {%- endif -%}
          .
        </figcaption>
      {% endif %}
    </figure>

    <div class="garden-book-review__intro">
      <p class="garden-intro__eyebrow">
        Reading{% if page.status %} &middot; {{ page.status }}{% endif %}
      </p>
      <h1>{{ page.title }}</h1>
      {% if page.author %}
        <p class="garden-book-review__author">{{ page.author }}</p>
      {% endif %}

      {% if started_at or finished_at or page.released or page.stars %}
        <dl class="garden-book-review__meta">
          {% if started_at %}
            <div>
              <dt>Started</dt>
              <dd>
                <time datetime="{{ started_at | date: '%Y-%m-%d' }}">{{ started_at | date: '%b %-d, %Y' }}</time>
              </dd>
            </div>
          {% endif %}
          {% if finished_at %}
            <div>
              <dt>Finished</dt>
              <dd>
                <time datetime="{{ finished_at | date: '%Y-%m-%d' }}">{{ finished_at | date: '%b %-d, %Y' }}</time>
              </dd>
            </div>
          {% endif %}
          {% if page.released %}
            <div>
              <dt>Released</dt>
              <dd>{{ page.released }}</dd>
            </div>
          {% endif %}
          {% if page.stars %}
            <div>
              <dt>Rating</dt>
              <dd>
                <span>{{ page.stars }}/5</span>
              </dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      {% if page.goodreads_review or page.buy_link %}
        <nav class="garden-book-review__actions" aria-label="Book links">
          {% if page.goodreads_review %}
            <a href="https://www.goodreads.com/review/show/{{ page.goodreads_review }}" rel="noopener" target="_blank">Review on Goodreads</a>
          {% endif %}
          {% if page.buy_link %}
            <a href="{{ page.buy_link }}" rel="noopener" target="_blank">Buy this book</a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  </header>

  {% if started_at or tags != '' or categories != '' %}
    <nav class="garden-book-review__filing" aria-label="Book filing">
      {% if started_at -%}
        <a href="{{ archive_year | prepend: '/books/' | append: '/' | relative_url }}">{{ archive_year }}</a>
      {%- endif %}
      {% for tag in page.tags %}
        <a href="{{ tag | slugify | prepend: '/books/tag/' | append: '/' | relative_url }}">#{{ tag }}</a>
      {% endfor %}
      {% for category in page.categories %}
        <a href="{{ category | slugify | prepend: '/books/category/' | append: '/' | relative_url }}">{{ category }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  {% assign review_content = content | strip %}
  {% if review_content != '' %}
    <div id="markdown-content" class="garden-prose">{{ content }}</div>
  {% elsif page.status %}
    <p class="garden-book-review__empty">{{ page.status | upcase }}</p>
  {% endif %}

  {% if site.books.size > 1 %}
    {% include garden-related.liquid collection=site.books current=page label='More reading' %}
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</article>

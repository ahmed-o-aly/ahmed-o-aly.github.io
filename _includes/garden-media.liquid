{% if include.src %}
  {% assign media_url = include.src %}
  {% assign media_parts = media_url | split: '.' %}
  {% assign media_extension = media_parts.last | downcase %}
  {% assign media_base = media_url | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
  {% assign media_zoom = include.zoom %}
  {% unless media_zoom == 'medium' or media_zoom == 'large' %}
    {% assign media_zoom = '' %}
  {% endunless %}
  {% assign media_loading = include.loading | default: 'lazy' %}
  {% unless media_loading == 'eager' %}
    {% assign media_loading = 'lazy' %}
  {% endunless %}
  {% assign media_fetchpriority = include.fetchpriority | default: 'auto' %}
  {% unless media_fetchpriority == 'high' or media_fetchpriority == 'low' %}
    {% assign media_fetchpriority = 'auto' %}
  {% endunless %}
  {% unless media_url contains '://' %}{% assign media_url = media_url | relative_url %}{% endunless %}
  <div class="garden-media garden-media--{{ include.fit | default: 'cover' }}{% if media_zoom != '' %} garden-media--zoom-{{ media_zoom }}{% endif %}">
    <picture>
      {% unless media_url contains '://' %}
        {% if site.imagemagick.enabled %}
          {% if media_extension == 'jpg'
            or media_extension == 'jpeg'
            or media_extension == 'png'
            or media_extension == 'tiff'
            or media_extension == 'gif'
          %}
            <source
              srcset="{% for width in site.imagemagick.widths %}{{ media_base | relative_url }}-{{ width }}.webp {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
              sizes="{{ include.sizes | default: '100vw' }}"
              type="image/webp"
            >
          {% endif %}
        {% endif %}
      {% endunless %}
      <img
        src="{{ media_url }}"
        alt="{{ include.alt | default: include.title }}"
        {% if include.width and include.height %}
          width="{{ include.width }}"
          height="{{ include.height }}"
        {% endif %}
        loading="{{ media_loading }}"
        fetchpriority="{{ media_fetchpriority }}"
        decoding="async"
      >
    </picture>
  </div>
{% else %}
  <div class="garden-media garden-media--fallback" aria-hidden="true">
    <span>{{ include.title | truncate: 48 }}</span>
  </div>
{% endif %}

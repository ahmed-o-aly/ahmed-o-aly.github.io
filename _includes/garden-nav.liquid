{% assign active_path = page.url | default: '/' %}
{% assign is_home = false %}
{% if active_path == '/' %}{% assign is_home = true %}{% endif %}
<header class="garden-header">
  <nav class="garden-nav" aria-label="Primary navigation">
    <a class="garden-nav__monogram" href="{{ '/' | relative_url }}" aria-label="Ahmed Aly, home">A<span>.</span></a>
    <div class="garden-nav__links">
      {% assign items = 'Writing|writing|/blog/;Library|library|/books/;Works|works|/projects/;Records|records|/cv/;Marginalia|marginalia|/marginalia/;About|about|/#sec-about' | split: ';' %}
      {% for item in items %}
        {% assign parts = item | split: '|' %}
        {% assign label = parts[0] %}
        {% assign section = parts[1] %}
        {% assign destination = parts[2] %}
        {% assign current = false %}
        {% if destination != '/#sec-about' and active_path contains destination %}{% assign current = true %}{% endif %}
        <a
          href="{% if is_home %}#sec-{{ section }}{% else %}{{ destination | relative_url }}{% endif %}"
          {% if is_home %}data-scroll-target="sec-{{ section }}"{% else %}data-page-turn{% endif %}
          {% if current %}aria-current="page"{% endif %}
        >
          {{- label -}}
        </a>
      {% endfor %}
    </div>
  </nav>
</header>

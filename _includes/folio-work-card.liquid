{% assign work = include.project %}
{% assign entry_index = include.index | default: 1 %}
{% if entry_index < 10 %}
  {% assign entry_number = entry_index | prepend: '0' %}
{% else %}
  {% assign entry_number = entry_index %}
{% endif %}
<li class="folio-work-entry">
  <a class="folio-work-entry__link" href="{{ work.url | relative_url }}">
    <span class="folio-work-entry__number" aria-hidden="true">{{ entry_number }}</span>
    <div class="folio-work-entry__copy">
      {% if include.heading_level == 2 %}
        <h2 class="folio-work-entry__title">{{ work.title }}</h2>
      {% else %}
        <h3 class="folio-work-entry__title">{{ work.title }}</h3>
      {% endif %}
      <p class="folio-work-entry__description">{{ work.description }}</p>
    </div>
  </a>
</li>
